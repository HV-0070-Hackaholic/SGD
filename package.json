{
  "name": "govpulse-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "GovPulse AI Smart Governance Dashboard Root Workspace - Telangana & India Command",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File smart-governance-dashboard/start-all.ps1",
    "start:backend": "cd smart-governance-dashboard/backend && npm run dev",
    "start:frontend": "cd smart-governance-dashboard/frontend && npm run dev",
    "start:ml": "cd smart-governance-dashboard/ml-service && python main.py"
  }
}
